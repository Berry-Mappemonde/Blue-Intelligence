[Unit]
Description=Blue Intelligence — UI + API (uvicorn, MongoDB local)
After=network-online.target mongod.service
Wants=mongod.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/blue-intelligence-map/backend
Environment=SERVE_FRONTEND=1
ExecStart=/home/ubuntu/blue-intelligence-map/backend/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3
TimeoutStartSec=180
# Pas de MemoryHigh : au-dessus du plafond souple le noyau met le process
# en pause (D / mem_cgroup_handle_over_high). Swap plein = API coincée,
# impossible à tuer vite (15 oct. 2026). MemoryMax + Restart=always :
# trop gros → tué, puis relancé. Sonde : blue-intelligence-health.timer.
TimeoutStopSec=30
MemoryMax=3G
# Soft 1024 (Ubuntu default) + climatology burst → EMFILE / nginx 500 / CF 525.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
