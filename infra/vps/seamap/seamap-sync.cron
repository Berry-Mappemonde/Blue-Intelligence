# Weekly sync of the sea-chart mirror (Open Waters: Seamap).
# The upstream planetary build runs on Monday 03:00 UTC; we sync on Monday
# 06:30 UTC. ETag discovery makes the lag safe: if the upstream
# build is not published yet, we simply resync the old one (no-op).
# Install: sudo cp seamap-sync.cron /etc/cron.d/seamap-sync
30 6 * * 1 ubuntu /srv/tiles/seamap/sync-seamap.sh >> /var/log/seamap-sync.log 2>&1
