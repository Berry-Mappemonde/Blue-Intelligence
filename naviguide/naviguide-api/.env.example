# NAVIGUIDE API — Environment Variables Template
# Copy to .env and fill in your values (never commit .env to git)
#   cp naviguide-api/.env.example naviguide-api/.env

# ── Copernicus Marine (existing) ─────────────────────────────────────────────
COPERNICUS_USERNAME=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password

# ── Cascade LLM — au moins une clé pour les 4 agents + l'orchestrateur ───────
# Ordre : NVIDIA NIM → OpenRouter → Anthropic Claude
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override default model (default: claude-opus-4-5)
# ANTHROPIC_MODEL=claude-opus-4-5

# ── StormGlass API — Agent Météo (optional) ───────────────────────────────────
# If not set, the meteo agent uses LLM training data only
# STORMGLASS_API_KEY=your_stormglass_key

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000

# ── LangSmith — microscope LOCAL uniquement ───────────────────────────────────
# Guide pas-à-pas : docs/LANGSMITH_NAVIGUIDE.md
# Ne jamais copier ce bloc sur le VPS. Sans LANGSMITH_LOCAL=1, le code ignore
# le tracing même si LANGSMITH_TRACING=true.
#
# 1. Crée les projets dans LangSmith (navigateur) :
#    naviguide-orchestrator-dev  et  naviguide-meteo-dev
# 2. Colle ta clé Settings → API Keys
# 3. Passe LANGSMITH_TRACING à true quand tu es prêt
LANGSMITH_LOCAL=1
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=naviguide-meteo-dev
LANGSMITH_TRACING_SAMPLING_RATE=1
