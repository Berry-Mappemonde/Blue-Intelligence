# NAVIGUIDE workspace (orchestrateur, agent 1, agent 3, polar)
# Copy to .env — never commit .env
#   cp naviguide_workspace/.env.example naviguide_workspace/.env
#
# start_local.sh charge aussi naviguide-api/.env pour tous les services.
# Ce fichier sert si tu lances l'orchestrateur tout seul.

NVIDIA_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ── LangSmith — microscope LOCAL uniquement ───────────────────────────────────
# Guide : docs/LANGSMITH_NAVIGUIDE.md  —  jamais sur le VPS.
LANGSMITH_LOCAL=1
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=naviguide-orchestrator-dev
LANGSMITH_TRACING_SAMPLING_RATE=1
