# Copy to .env (gitignored) and fill in. Placeholders only: never commit real values.
# With no .env at all, backend/run.py runs in SAMPLE_MODE on bundled data.

# Zetaris (data layer)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=your-org-id
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift (OpenAI-compatible runtime)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto

# Optional: direct NVIDIA Nemotron fallback when Nightshift is unreachable
NVIDIA_API_KEY=

# true forces bundled sample data and no model calls; leave empty to auto-detect
SAMPLE_MODE=

# python backend/run.py --serve
PORT=8000
LOG_LEVEL=INFO
