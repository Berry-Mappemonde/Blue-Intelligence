# Confirmation code for sensitive actions (Swarm, Clear, Force Extract). If set, all protected actions require this code.
# Leave empty to disable protection. Use a strong secret for hackathon/demo (share with judges only).
BLUEINTEL_CONFIRM_CODE=

# TinyFish API Key (Required for agent extraction)
TINYFISH_API_KEY=

# Claude API Key (Required for analyzing scraped data - extraction)
# Use CLAUDE_API_KEY or ANTHROPIC_API_KEY (e.g. from Cursor Secrets)
CLAUDE_API_KEY=

# Scrape.do API Key (Optional, fallback for web scraping)
# Prefer SCRAPE_DO_API_KEY (no dot) for compatibility; SCRAPE.DO_API_KEY also works
SCRAPE_DO_API_KEY=

# Jina Reader API Key (Optional, fallback for web scraping)
JINA_READER_API_KEY=

# Firecrawl API Key (Optional, fallback for web scraping)
FIRECRAWL_API_KEY=

# Preset CDX non secret (per_url, 2005, collapse mensuel) : voir env/wayback-cdx.public.env
#
# CDX Wayback : CDX_NO_PROXY=1 pour requêtes directes (sans proxy) si timeouts
# CDX_NO_PROXY=

# Mode CDX : bulk = wildcard paginé (historique lourd) | per_url = une requête CDX par page wiki (recommandé)
# CDX_MODE=bulk

# Année minimale CDX : en bulk défaut 2005 ; en per_url défaut 2019 si non défini. Ex. repartir de 2019 pour tout :
# CDX_FROM_YEAR=2019

# Per-URL (CDX_MODE=per_url) : nombre max de captures stockées par URL, délai entre lots, concurrence 1–8
# CDX_PER_URL_LIMIT=12
# CDX_PER_URL_DELAY_MS=500
# CDX_PER_URL_CONCURRENCY=2
# Optionnel : collapse par URL (digest, timestamp:6, …) ; none ou vide = pas de collapse. Voir docs/WAYBACK_CDX.md
# CDX_PER_URL_COLLAPSE=
# CDX_PER_URL_SORT_REVERSE=true force sort=reverse côté API (sinon tri client sur un échantillon élargi)

# CDX_COLLAPSE : digest | timestamp:6 (mois) | timestamp:8 (jour). Défaut: timestamp:6 (mode bulk uniquement)
# CDX_COLLAPSE=timestamp:6

# Liste des URLs en mode per_url : auto = CDX wildcard (web.archive.org) puis repli MediaWiki | cdx = uniquement wildcard | mediawiki = uniquement api.php
# CRUISERSWIKI_URL_SOURCE=auto
# Plage années pour l’inventaire CDX wildcard (sans appeler cruiserswiki.org). Défaut : CDX_FROM_YEAR per_url → année courante
# CRUISERSWIKI_CDX_URL_FROM_YEAR=
# CRUISERSWIKI_CDX_URL_TO_YEAR=
# Limite requêtes paginées CDX wildcard (total). Défaut 5000 ; valeur ≤0 → 5000
# CRUISERSWIKI_CDX_URL_MAX_PAGES=5000
# Collapse inventaire wildcard (défaut urlkey). Si l’API IA échoue, essayer digest ou basculer CRUISERSWIKI_URL_SOURCE=mediawiki
# CDX_WILDCARD_COLLAPSE=urlkey

# Phase 2 : seuil minimal (jours) pour compter un changement de digest. Défaut: 7
# WAYBACK_MIN_CHANGE_INTERVAL_DAYS=7

# Pack d'extraction nauticals (regex + heuristiques). Chemin absolu ou relatif au cwd. Défaut: data/nautical-extraction-pack.default.json
# NAUTICAL_EXTRACTION_PACK_PATH=

# Cruisers Wiki (protégé Cloudflare) - au moins une option requise :
# 1. FlareSolverr (gratuit) : docker run -d -p 8191:8191 ghcr.io/flaresolverr/flaresolverr
# 2. SCRAPE_DO_API_KEY : proxy (1000 crédits/mois gratuits)
# 3. CRUISERSWIKI_PROXY_URL : proxy custom
# FLARESOLVERR_URL=http://localhost:8191/v1 (défaut)
CRUISERSWIKI_PROXY_URL=