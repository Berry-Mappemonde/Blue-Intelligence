# Configuration CDX / Wayback — aucun secret (commitable).
# À fusionner dans votre .env local : copier-coller ces lignes ou :
#   export $(grep -v '^#' env/wayback-cdx.public.env | xargs) && npm run dev
# Voir aussi : docs/WAYBACK_CDX.md

# Liste des pages : CDX wildcard sur web.archive.org d’abord (évite Cloudflare sur le site live), puis repli MediaWiki si besoin
CRUISERSWIKI_URL_SOURCE=auto
# CRUISERSWIKI_CDX_URL_FROM_YEAR=2019
# CRUISERSWIKI_CDX_URL_TO_YEAR=
CRUISERSWIKI_CDX_URL_MAX_PAGES=5000
CDX_WILDCARD_COLLAPSE=urlkey

# --- Mode recommandé : une requête CDX par page wiki ---
CDX_MODE=per_url

# Historique depuis 2005 (avec collapse mensuel ci-dessous ≈ 12 captures / an / URL)
CDX_FROM_YEAR=2005

# Au plus une entrée CDX par mois (timestamp:6 = année+mois). Requis pour « 1 / mois » en per_url.
CDX_PER_URL_COLLAPSE=timestamp:6

# Nombre max de captures conservées par URL après tri (≈ nb de mois couverts).
# 2005→année courante ≈ 250–300 mois ; ajuster si la fenêtre temporelle change.
CDX_PER_URL_LIMIT=280

# Réactivité réseau / proxy (éviter les timeouts)
CDX_PER_URL_DELAY_MS=500
CDX_PER_URL_CONCURRENCY=1

# Si le proxy CDX est lent : tester requêtes directes vers web.archive.org
# CDX_NO_PROXY=1

# Optionnel : true = sort=reverse côté API CDX (sinon tri client sur échantillon élargi)
# CDX_PER_URL_SORT_REVERSE=true

# --- Mode bulk (wildcard) : collapse mensuel par défaut dans le code ; surcharge possible ---
# CDX_COLLAPSE=timestamp:6

# --- Phase 2 Wayback (fréquence de modification) ---
# WAYBACK_MIN_CHANGE_INTERVAL_DAYS=7

# --- Pack d’extraction nauticals (fichier versionnable, pas une clé) ---
# NAUTICAL_EXTRACTION_PACK_PATH=data/nautical-extraction-pack.default.json
